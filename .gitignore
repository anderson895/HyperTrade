venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Runtime data: SQLite DB, logs, any local secrets. Never commit.
# Anchored with a leading slash so it means *this* data directory. Unanchored,
# `data/` matched any directory of that name at any depth — which silently kept
# src/data/ (the whole Hyperliquid client) out of the repository.
/data/
*.log
*.db
.env

# Build output
build/
dist/
*.spec.bak
credentials.txt

# The client's specification and the internal development guide. Deliberately out
# of a public repository: README.md reproduces every rule they set, so nothing a
# reader needs is behind this line.
/development_guide/